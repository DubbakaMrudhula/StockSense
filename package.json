{
  "name": "odoo-enterprise-inventory",
  "version": "1.0.0",
  "description": "Odoo Inventory - Core Data Foundation & Product Management (Member 1)",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "migrate": "npm run migrate --prefix server",
    "seed": "npm run seed --prefix server",
    "db:reset": "npm run db:reset --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
